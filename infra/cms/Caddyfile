# Caddy davanti al WordPress headless. TLS automatico (Let's Encrypt).
#
# IL BLOCCO PIU' IMPORTANTE E' `X-Robots-Tag: noindex`. Senza, Google indicizza il CMS e si
# ritrova due copie di ogni articolo, la nostra e quella del sottodominio.
#
# Eccezione voluta: le IMMAGINI. Il sito pubblico le serve passando per il suo dominio; se
# l'header noindex arrivasse fin li', sul dominio vero sparirebbero da Google Immagini. Sul CMS
# nessuno le linka (il frontend riscrive ogni URL sul dominio pubblico), quindi il rischio di
# lasciarle senza noindex qui e' basso. Il sito di prova su vercel.app mette il suo noindex.

{$DOMINIO_CMS} {
	@immagini path /wp-content/uploads/*

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# La conservazione lunga vale SOLO per le immagini servite davvero (dentro handle, sotto). Prima stava
	# qui e finiva anche sulle risposte di errore: il 17/10/2026, con WordPress fermo, Vercel ha conservato
	# dei 502 come se fossero immagini e i telefoni le vedevano rotte.
	@non_immagini not path /wp-content/uploads/*
	header @non_immagini X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"

	# La dashboard e il login chiedono una password PRIMA di WordPress: i tentativi automatici
	# sbattono su Caddy. Non un filtro per IP: le connessioni di casa cambiano indirizzo.
	# La REST (/wp-json) resta aperta: la leggono il sito al build e wpvibe per pubblicare.
	@amministrazione path /wp-admin* /wp-login.php
	basic_auth @amministrazione {
		{$ADMIN_UTENTE} {$ADMIN_HASH}
	}
	# Le credenziali della porta non arrivano MAI a WordPress (23/10/2026). Se le vede, crede che il sito
	# usi l'autenticazione di base e blocca le password delle applicazioni; e wpvibe rifiuta l'approvazione
	# («logged-in browser session only»). Il browser le rimanda da solo a tutto il CMS, /wp-json compreso,
	# quindi si riconoscono dal valore esatto e si tolgono ovunque: le password delle applicazioni vere
	# (wpvibe, anteprima delle bozze) hanno un altro valore e passano.
	@porta header Authorization "Basic {$ADMIN_BASIC}"
	request_header @porta -Authorization

	# I blocchi stanno dentro `handle`: un `respond` sciolto viene DOPO `handle` nell'ordine di Caddy, e
	# dal 17/10/2026 (quando e' arrivato `handle { reverse_proxy }`) non scattava piu': il 22/10 readme.html,
	# license.txt e sitemap_index.xml rispondevano 200. Gli `handle` si escludono a vicenda e quello senza
	# filtro, sotto, vale per ultimo.

	# XML-RPC non serve a un CMS headless ed e' il bersaglio piu' battuto di WordPress
	@xmlrpc path /xmlrpc.php
	handle @xmlrpc {
		respond 403
	}

	@vietati path /wp-config.php /.env /debug.log /readme.html /license.txt /wp-content/debug.log
	handle @vietati {
		respond 403
	}

	# Niente sitemap ne' llms.txt del CMS: elencherebbero gli articoli sul dominio sbagliato.
	# Il mu-plugin le spegne gia', ma un aggiornamento di Yoast le ha riaccese una volta.
	@sitemap path /wp-sitemap*.xml /sitemap*.xml /sitemap_index.xml /*-sitemap.xml /*-sitemap*.xml /sitemap.xsl /main-sitemap.xsl /llms.txt
	handle @sitemap {
		respond 404
	}

	request_body {
		max_size 64MB
	}

	# Le immagini caricate: dal disco, direttamente da Caddy (volume di WordPress in sola lettura). Non
	# dipendono da PHP: se WordPress e' lento o fermo, il sito continua a mostrarle. Un file che non
	# c'e' risponde 404 come prima.
	handle @immagini {
		root * /srv/wp
		# solo se il file esiste davvero: un 404 non si conserva
		@esiste file
		header @esiste Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
		file_server
	}

	# Nessun errore si conserva: un 404 o un 502 non deve restare in memoria a Vercel o al browser
	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
	handle {
		reverse_proxy wp:80
	}

	encode zstd gzip
	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

# Umami, il contatore delle visite senza cookie (infra/umami/, 24/10/2026): pannello del proprietario e
# raccolta delle visite del sito. Fuori da Google come il CMS.
visite.ilplatinatore.it {
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	encode zstd gzip

	# Il pannello di Umami e' in inglese e Chrome lo traduce da solo: la traduzione riscrive la pagina sotto
	# React e il pannello si blocca prima di aprirsi («insertBefore», 27/10/2026). Alla prima apertura dal
	# browser si passa da /italiano, che mette la lingua di Umami (localStorage) in italiano e lascia un
	# cookie per non ripassarci: una pagina gia' italiana il browser non la traduce.
	# Nel testo della pagina niente graffe: Caddy le leggerebbe come segnaposto.
	@prima_volta {
		header Sec-Fetch-Dest document
		not header Cookie *pl_it=1*
		not path /italiano /pl.js /api/*
	}
	redir @prima_volta /italiano 302

	handle /italiano {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		respond `<!doctype html><html lang="it" translate="no"><meta charset="utf-8"><meta name="google" content="notranslate"><meta name="viewport" content="width=device-width"><title>Visite</title><p>Apro il pannello in italiano... <a href="/">Entra</a></p><script>document.cookie="pl_it=1; max-age=31536000; path=/; secure; samesite=lax";localStorage.setItem("umami.locale",JSON.stringify("it-IT"));location.replace("/")</script></html>` 200
	}
	handle {
		reverse_proxy umami:3000
	}
}
