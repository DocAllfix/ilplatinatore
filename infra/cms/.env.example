# Il .env vero sta SOLO sul server, in /opt/platinatore-cms/.env a permessi 600, e nel gestore di
# password. Lo genera installa.sh, che non lo rigenera mai: i token devono restare uguali a
# quelli impostati su Vercel.
#
# TRAPPOLA: `docker compose` espande `$nome` dentro questo file. Una password con `$` seguito da
# lettere arriva troncata al contenitore, senza errori. installa.sh genera solo valori esadecimali.

DOMINIO_CMS=cms.ilplatinatore.it
SITO_PUBBLICO=                 # oggi il sito di prova su vercel.app; al passaggio https://www.ilplatinatore.it

DB_ROOT_PASSWORD=
DB_PASSWORD=

WEBHOOK_TOKEN=                 # = CMS_WEBHOOK_TOKEN su Vercel. Non finisce mai in un URL.
PREVIEW_TOKEN=                 # = CMS_PREVIEW_TOKEN su Vercel. Viaggia negli URL di anteprima.

ADMIN_UTENTE=                  # password davanti a /wp-admin: utente
ADMIN_HASH=                    # hash bcrypt generato da `caddy hash-password`

# backup (vedi backup.sh)
STORAGE_BOX=                   # u635762-sub6@u635762.your-storagebox.de
HEALTHCHECK_URL=               # allarme «uomo morto» (healthchecks.io): scatta se il backup NON avvisa
